<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phobos — Rhythmic Grid</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;700&display=swap');

        :root {
            --brand-dark: #122B1C;
            --brand-deep: #0A190F;
            --brand-accent: #CAA552;
            --brand-beige: #F5F5DC;
        }

        body {
            font-family: 'Geist Mono', monospace;
            background-color: var(--brand-deep);
            background-image: radial-gradient(circle at 2px 2px, rgba(202, 165, 82, 0.1) 1px, transparent 0);
            background-size: 40px 40px;
        }

        .glass-panel {
            background: rgba(18, 43, 28, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(202, 165, 82, 0.2);
        }

        .bento-cell {
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .bento-cell:hover {
            border-color: var(--brand-accent);
            transform: translateY(-4px);
            background: rgba(22, 66, 33, 0.8);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body class="min-h-[100dvh] text-brand-beige selection:bg-brand-accent selection:text-brand-deep">

    <nav class="flex justify-center flex-wrap gap-3 p-6 mb-12">
        <a href="PhobosBasic.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Basic</a>
        <a href="PhobosButton.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Button</a>
        <a href="PhobosFlLayout.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Layout</a>
        <a href="PhobosGridLayout.html" class="px-4 py-2 bg-black text-brand-accent rounded-lg text-sm font-bold border border-brand-accent">Griddy</a>
        <a href="PhobosMedia.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Media</a>
        <a href="PhobosMiniProject.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">MiniProj</a>
        <a href="PhobosNavBar.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">NavBar</a>
        <a href="PhobosProfile.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Profile</a>
        <a href="PhobosResume.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Resume</a>
        <a href="PhobosStyledForm.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Styled Form</a>
        <a href="PhobosKraber.html" class="px-4 py-2 glass-panel rounded-lg text-sm font-bold hover:bg-black hover:text-brand-accent transition-all duration-300">Archives</a>
    </nav>

    <main class="max-w-6xl mx-auto px-6 pb-24">
        <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-auto gap-6">
            <!-- Hero Cell -->
            <div class="bento-cell glass-panel md:col-span-2 md:row-span-2 p-8 rounded-3xl flex flex-col justify-between relative overflow-hidden">
                <div class="absolute -top-12 -right-12 w-48 h-48 bg-brand-accent/10 blur-3xl rounded-full pointer-events-none"></div>
                <div>
                    <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-4 leading-none">Phobos</h1>
                    <p class="text-lg opacity-70 max-w-md leading-relaxed">
                        A sanctuary for contemplative archives and the architecture of forgetting.
                    </p>
                </div>
                <div class="text-[10px] uppercase tracking-[0.3em] text-brand-accent opacity-50 font-bold mt-12">
                    Section 01 // Core
                </div>
            </div>

            <!-- Status Cell -->
            <div class="bento-cell glass-panel p-6 rounded-3xl flex flex-col justify-between border-l-4 border-l-brand-accent">
                <h3 class="font-bold text-sm uppercase tracking-widest text-brand-accent mb-2">Status</h3>
                <p class="text-sm opacity-80">Winter Solstice active. Cold thresholds maintained.</p>
            </div>

            <!-- Index Cell -->
            <div class="bento-cell glass-panel p-6 rounded-3xl flex flex-col justify-between">
                <h3 class="font-bold text-sm uppercase tracking-widest mb-2">Index</h3>
                <p class="text-sm opacity-80">Fragments of the city, mapped by sound and silence.</p>
            </div>

            <!-- Wide Archive Cell -->
            <div class="bento-cell glass-panel md:col-span-2 p-6 rounded-3xl flex flex-col justify-between">
                <h3 class="font-bold text-sm uppercase tracking-widest mb-2">The Archive</h3>
                <p class="text-sm opacity-80 leading-relaxed">
                    Collecting the whispers of a thousand-year-old cathedral before the dust claims the altar.
                </p>
            </div>

            <!-- Tall Manifesto Cell -->
            <div class="bento-cell glass-panel md:row-span-2 p-6 rounded-3xl flex flex-col justify-between relative overflow-hidden">
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-widest mb-4">Manifesto</h3>
                    <p class="text-sm opacity-80 leading-relaxed mb-6">
                        We build not to last, but to witness the beauty of the crumble.
                    </p>
                </div>
                <div class="h-24 w-full border border-dashed border-white/10 rounded-xl flex items-center justify-center opacity-30">
                    <span class="text-xs uppercase tracking-widest">Void Analysis</span>
                </div>
            </div>

            <!-- Metrics Cell -->
            <div class="bento-cell glass-panel p-6 rounded-3xl flex flex-col justify-between">
                <h3 class="font-bold text-sm uppercase tracking-widest mb-2">Metrics</h3>
                <div class="text-2xl font-bold text-brand-accent">47</div>
                <p class="text-[10px] opacity-50 uppercase tracking-tighter">Fragments recovered</p>
            </div>

            <!-- Echoes Cell -->
            <div class="bento-cell glass-panel p-6 rounded-3xl flex flex-col justify-between">
                <h3 class="font-bold text-sm uppercase tracking-widest mb-2">Echoes</h3>
                <div class="text-2xl font-bold text-brand-accent">0.04%</div>
                <p class="text-[10px] opacity-50 uppercase tracking-tighter">Recurrence rate</p>
            </div>
        </div>
    </main>

    <footer class="mt-auto py-12 text-center opacity-30 text-xs italic">
        &copy; Nengasca, Renzo D. : WD303
    </footer>
</body>
</html>
